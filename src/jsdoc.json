{
"tags": {
"allowUnknownTags": true,
"dictionaries": ["jsdoc", "closure"]
},
"source": {
"include": ["js", "README.md"],
"includePattern": ".+\\.js(doc|x)?$",
"excludePattern": "(^|\\/|\\\\)_"
},
"plugins": [
"plugins/markdown"
],
"opts": {
"template": "templates/default",
"encoding": "utf8",
"destination": "./docs",
"recurse": true,
"readme": "README.md"
}
}
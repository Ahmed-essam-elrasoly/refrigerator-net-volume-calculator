subgraph DYN["solver.js — runThermalAnalysisDynamic(config)<br/>OUTER TE LOOP  (max 15 iterations)"]
  DYN0["TE = config.initialTE"] --> DYN1["i = 0"]
  DYN1 --> DYN2["result = solveThermalSystem(config, TE)"]
  DYN2 -.calls.-> TCS0
  TCS0 -.returns.-> DYN3
  DYN3{"result.converged?"}
  DYN3 -- No --> DYNF["return result (failure propagates up)"]
  DYN3 -- Yes --> DYN4["error = calculateNewTE(result, fan, evapGeom, TF, TR) - TE<br/>(uses NTU-effectiveness re-estimate of TE)"]
  DYN4 --> DYN5{"abs(error) < 0.1?"}
  DYN5 -- Yes --> DYN6["result.TE = TE + error<br/>call evaluateSafetyCheckpoints(result, config, TE+error)"]
  DYN6 -.calls.-> SAFE0
  SAFE0 -.returns.-> DYNOK["return result (converged)"]
  DYN5 -- No --> DYN7{"i > 0 and<br/>prevError defined?"}
  DYN7 -- Yes --> DYN7a["TE += clamp(-3..3,<br/>-error*(TE-prevTE)/(error-prevError))<br/>(secant-style update)"]
  DYN7 -- No --> DYN7b["TE += 0.5 * error"]
  DYN7a --> DYN8["prevTE = TE (pre-update)<br/>prevError = error<br/>i++"]
  DYN7b --> DYN8
  DYN8 --> DYN9{"i < 15?"}
  DYN9 -- Yes --> DYN2
  DYN9 -- No --> DYNF2["return converged:false,<br/>error:'Thermodynamic imbalance: TE loop failed.'"]
end

subgraph TCS["solver.js — solveThermalSystem(config, TE_override)<br/>OUTER TC SECANT LOOP  (max maxIterOuter, default 100)"]
  TCS0{"evapGeom missing?"} -- Yes --> TCSTHROW["throw Error('evapGeom missing from config')"]
  TCS0 -- No --> TCS1["TE = TE_override ?? config.initialTE<br/>fixedPR = config.inverterPR<br/>TC = TC0 (default 45 or from solverOptions)"]
  TCS1 --> TCS2["iter = 0"]
  TCS2 --> TCS3{"TC < T0?"}
  TCS3 -- Yes --> TCS3a["TC = T0 + 2"]
  TCS3 -- No --> TCS4
  TCS3a --> TCS4{"TC > 90?"}
  TCS4 -- Yes --> TCS4a["TC = 90"]
  TCS4 -- No --> TCS5
  TCS4a --> TCS5["inner = solveInner(TC, geom, compParams, refrigerant,<br/>subcool, fixedTemps, fan, electrical, condenserConfig,<br/>TE, freezerPosition, innerOptions, fixedPR, evapGeom)"]
  TCS5 -.calls.-> INR0
  INR0 -.returns.-> TCS6
  TCS6{"inner.converged?"}
  TCS6 -- No --> TCS6a{"inner.error contains<br/>'undersized'?"}
  TCS6a -- Yes --> TCSF1["return createFailure(TC, 'Compressor undersized.', inner)"]
  TCS6a -- No --> TCS6b{"inner.error contains<br/>'oversized'?"}
  TCS6b -- Yes --> TCSF2["return createFailure(TC, 'Compressor oversized.', inner)"]
  TCS6b -- No --> TCS6c{"inner.error contains<br/>'SLHX'?"}
  TCS6c -- Yes --> TCSF3["return createFailure(TC, inner.error, inner)"]
  TCS6c -- No --> TCSF4["return createFailure(TC, 'Inner loop failed.', inner)"]
  TCS6 -- Yes --> TCS7["totalInner += inner.iterations<br/>prevInner = {T2, PR, RPM}"]
  TCS7 --> TCS8["QCout = calcQCout(geom, TC, T0, TF, TR, inner.PR,<br/>PIPEPITCH, freezerPosition, backCondenserEfficiency)"]
  TCS8 -.calls.-> COND0
  COND0 -.returns.-> TCS9
  TCS9["compOuter = evaluateCompressorSafely(TE, TC,<br/>refIndex, compParams, inner.RPM)"]
  TCS9 -.calls.-> CMP0
  CMP0 -.returns.-> TCS10
  TCS10["h_cond_exit = liquidEnthalpy(TC-subcool)<br/>h_discharge = gasEnthalpy(dischargeTemp, satPressure(TC))<br/>F3 = QCout.QCout - massFlow*(h_discharge-h_cond_exit)/3.6"]
  TCS10 --> TCS11{"abs(F3) < tolOuter?"}
  TCS11 -- Yes --> TCSOK["return TC, T2, PR, T3, RPM, TE, Pe, Pc, Tsubcool,<br/>converged:true, outerIterations, innerTotalIterations,<br/>heatLoads, compressor, MR, MF, fan, electrical"]
  TCS11 -- No --> TCS12["TRY: innerPert = solveInner(TC+0.001, ...same args)"]
  TCS12 -.calls.-> INR0
  TCS12 --> TCS13{"innerPert.converged?<br/>(no exception)"}
  TCS13 -- Yes --> TCS14["compOuter_pert = evaluateCompressorSafely(...)<br/>QCout_pert = calcQCout(TC+0.001, ...)<br/>F3_pert = QCout_pert - massFlow_pert*(h_disch_pert-h_cond_pert)/3.6"]
  TCS14 --> TCS15["TC -= clamp(-5..5,<br/>F3 / ((F3_pert-F3)/0.001))"]
  TCS13 -- No --> TCS16{"prevF3 and prevTC<br/>defined?"}
  TCS16 -- Yes --> TCS16a["TC -= clamp(-5..5,<br/>F3 / ((F3-prevF3)/(TC-prevTC)))<br/>(secant using prior outer iteration)"]
  TCS16 -- No --> TCS16b["TC += (F3 > 0 ? -0.5 : 0.5)"]
  TCS15 --> TCS17["prevF3 = F3; prevTC = TC; iter++"]
  TCS16a --> TCS17
  TCS16b --> TCS17
  TCS17 --> TCS18{"iter < maxIterOuter?"}
  TCS18 -- Yes --> TCS3
  TCS18 -- No --> TCSF5["return createFailure(TC,<br/>'Outer loop max iterations reached', prevInner)"]
end

subgraph INR["solver.js — solveInner(...)<br/>2-D NEWTON SOLVE for [T2, PR-or-RPM]"]
  INR0["isInverterMode = compParams.isInverter<br/>&& fixedPR !== undefined"] --> INR1{"isInverterMode?"}
  INR1 -- Yes --> INR1a["bounds = [[-80,20],[rpmMin,rpmMax]]<br/>initialGuess = [-21.25, initialRPM ?? 3000]"]
  INR1 -- No --> INR1b["bounds = [[-80,20],[0.001,0.999]]<br/>(or forced to forcePR if set)<br/>initialGuess = [-21.25, forcePR ?? initialPR ?? 0.59]"]
  INR1a --> INR2
  INR1b --> INR2["define F(vars) = [f1, f2]:"]
  INR2 --> INRF1["loads = calcHeatLoads(geom, {...fixedTemps,T2,TC,PR,TE:-25},<br/>electrical, PIPEPITCH, backCondenserEfficiency,<br/>fan.inputPower_W, freezerPos, backCondenser)"]
  INRF1 -.calls.-> HL0
  HL0 -.returns.-> INRF2
  INRF2["v_ms = (fan.fanAirflow_m3h/3600) / faceArea_m2<br/>alpha = 12.93 * v_ms^0.415 * 1.16279<br/>UA = alpha * evapGeom.evapArea_m2<br/>LMTD_req = (QF+QR+QEV) / PR / UA"]
  INRF2 --> INRF3["T3 = T2 + QEV/(Flow*CV*PR)<br/>MR = clamp(0, Flow, QR/(CV*max(0.01,TR-T3)*PR*Damp))<br/>MF = Flow - MR<br/>T1 = (MF*TF + MR*TR) / Flow"]
  INRF3 --> INRF4{"isInverterMode and<br/>RPM out of [rpmMin,rpmMax]?<br/>OR !isInverterMode and<br/>PR out of [0.001,0.999]?"}
  INRF4 -- Yes --> INRFerr["return {error: 'RPM/PR out of bounds'}"]
  INRF4 -- No --> INRF5["calculated_TE = solveTE_Brent(T1, T2, LMTD_req)"]
  INRF5 -.calls.-> BR0
  BR0 -.returns.-> INRF6
  INRF6{"isFinite(calculated_TE)?"}
  INRF6 -- No --> INRFerr2["return {error: 'TE search failed: LMTD impossible'}"]
  INRF6 -- Yes --> INRF7["comp = evaluateCompressorSafely(calculated_TE, TC,<br/>refIndex, compParams, RPM)"]
  INRF7 -.calls.-> CMP0
  CMP0 -.returns.-> INRF8
  INRF8["SLHX energy balance:<br/>T_cond_exit=TC-subcool; h_liq_cond_exit=liquidEnthalpy(...)<br/>T_suction_actual=min(30,T_cond_exit)<br/>h_suc_out/h_suc_in via gasEnthalpy<br/>h_liq_exp_in = h_liq_cond_exit - max(0,h_suc_out-h_suc_in)<br/>clamp to liquidEnthalpy(TE) floor"]
  INRF8 --> INRF9["comp.QCompressor = massFlow*(hGas_TE-h_liq_exp_in)/3.6<br/>Tsubcool = getTemperatureFromLiquidEnthalpy(h_liq_exp_in)<br/>(bisection, 50 iters)"]
  INRF9 --> INRF10["f1 = QF - MF*CV*(TF-T3)*PR<br/>f2 = (QF+QR+QEV) - QCompressor*PR<br/>return [f1, f2]"]
  INRF10 --> INR3["res = newton2(F, initialGuess, [dx,dx],<br/>tol, maxIter, bounds)"]
  INR3 -.calls.-> N20
  N20 -.returns.-> INR4
  INR4{"res.converged?"}
  INR4 -- Yes --> INR9
  INR4 -- No --> INR5{"error is<br/>'undersized' or<br/>'oversized' limit?"}
  INR5 -- Yes --> INR9
  INR5 -- No --> INR6["build fallback guesses list<br/>(inverter: mid/min/max RPM combos;<br/>constant: PR 0.4/0.5/0.3 combos)"]
  INR6 --> INR7["for each fallback guess:<br/>res = newton2(F, guess, ...)"]
  INR7 -.calls.-> N20
  INR7 --> INR8{"any guess<br/>converged?"}
  INR8 -- Yes --> INR9
  INR8 -- No --> INRFAIL["return {...res, T2:res.x[0],<br/>PR or RPM: res.x[1], converged:false}"]
  INR9{"res.converged?"}
  INR9 -- No --> INRFAIL
  INR9 -- Yes --> INR10["Recompute final state at solution x:<br/>loads = calcHeatLoads(...)<br/>comp = evaluateCompressorSafely(...)<br/>re-apply SLHX capacity + Tsubcool<br/>T3, MR, MF, T1 recomputed"]
  INR10 --> INROK["return {T2,PR,RPM,TE,converged:true,<br/>iterations, warning, heatLoads,<br/>compressor{etaV,coolingCapacity,inputPower,<br/>COP,massFlow,Pe,Pc}, MR, MF, T3, Tsubcool, T1}"]
end

subgraph N2["solver.js — newton2(F, x0, dx, tol, maxIter, bounds)<br/>GENERIC 2-D NEWTON-RAPHSON + ARMIJO BACKTRACKING LINE SEARCH"]
  N20["x = x0; f = F(x0)"] --> N21{"f.error?"}
  N21 -- Yes --> N2FAIL0["return converged:false,<br/>error:'Initial F(x) failed'"]
  N21 -- No --> N22["normF = sqrt(f0^2+f1^2)<br/>i = 0"]
  N22 --> N23{"normF <= tol?"}
  N23 -- Yes --> N2OK["return converged:true, x, f, normF, iterations:i+1"]
  N23 -- No --> N24["compute Jacobian J via finite differences<br/>(h = max(1e-7, abs(x_j)*1e-6);<br/>perturb backward if forward exceeds upper bound)"]
  N24 --> N25{"F(x+h) threw<br/>an error?"}
  N25 -- Yes --> N2FAIL1["return converged:false,<br/>error:'Jacobian failed: msg'"]
  N25 -- No --> N26["det = J00*J11 - J01*J10"]
  N26 --> N27{"abs(det) > 1e-12?"}
  N27 -- Yes --> N27a["direction = -inv(J) * f<br/>(closed-form 2x2 solve)"]
  N27 -- No --> N27b["direction = gradient-descent step<br/>= -(J^T * f)"]
  N27b --> N27c{"norm(direction) < 1e-12?"}
  N27c -- Yes --> N2FAIL2["return converged:false,<br/>error:'Saddle point.'"]
  N27c -- No --> N28
  N27a --> N28["clamp direction:<br/>maxStepT2=5.0<br/>maxStepVar2 = domainSpan>2 ? 500 : 0.15"]
  N28 --> N29["alpha = 1.0; bt = 0"]
  N29 --> N30["newX = clamp(x + alpha*direction, bounds)"]
  N30 --> N31{"F(newX) threw?"}
  N31 -- Yes --> N31a["alpha *= 0.5; bt++"]
  N31 -- No --> N32["newNorm = sqrt(newF0^2+newF1^2)<br/>Armijo: newNorm < normF*(1 - 1e-4*alpha) ?"]
  N32 --> N33{"enoughDecrease?"}
  N33 -- Yes --> N34["accept step: x=newX, f=newF, normF=newNorm"]
  N33 -- No --> N31a
  N31a --> N35{"bt < 15?"}
  N35 -- Yes --> N30
  N35 -- No --> N36{"line search<br/>exhausted (bt=15)"}
  N36 --> N37{"x[1] at lower bound<br/>and direction[1] < 0?"}
  N37 -- Yes --> N2WARN1["return converged:true,<br/>warning:'Compressor oversized limit.'"]
  N37 -- No --> N38{"x[1] at upper bound<br/>and direction[1] > 0?"}
  N38 -- Yes --> N2WARN2["return converged:true,<br/>warning:'Compressor undersized limit.'"]
  N38 -- No --> N2FAIL3["return converged:false,<br/>error:'Line search failed.'"]
  N34 --> N39["i++"]
  N39 --> N40{"i < maxIter?"}
  N40 -- Yes --> N23
  N40 -- No --> N2FAIL4["return converged:false,<br/>error:'Max iterations reached'"]
end

subgraph BR["solver.js — solveTE_Brent(T1, T2, LMTD_req)<br/>BRENT'S METHOD ROOT FINDER for TE"]
  BR0["f(TE) = lmtd(T1,T2,TE) - LMTD_req<br/>(catch lmtd RangeError -> return Infinity)"] --> BR1["a = -40.0<br/>b = min(T1,T2) - 0.1"]
  BR1 --> BR2{"f(a)*f(b) > 0<br/>and a > -65?"}
  BR2 -- Yes --> BR2a["a -= 10"]
  BR2a --> BR2
  BR2 -- No --> BR3{"f(a)*f(b) > 0<br/>still (bracket failed)?"}
  BR3 -- Yes --> BRNAN["return NaN"]
  BR3 -- No --> BR4["fa=f(a), fb=f(b);<br/>if fa>0 swap(a,b)<br/>c=a, fc=fa, mflag=true, iter=0"]
  BR4 --> BR5{"fa != fc<br/>and fb != fc?"}
  BR5 -- Yes --> BR5a["s = inverse quadratic interpolation<br/>using a,b,c,fa,fb,fc"]
  BR5 -- No --> BR5b["s = secant: b - fb*(b-a)/(fb-fa)"]
  BR5a --> BR6
  BR5b --> BR6{"s outside [(3a+b)/4, b] OR<br/>(mflag and |s-b|>=|b-c|/2) OR<br/>(!mflag and |s-b|>=|c-d|/2) OR<br/>(mflag and |b-c|<tol) OR<br/>(!mflag and |c-d|<tol)?"}
  BR6 -- Yes --> BR6a["s = (a+b)/2 (bisection)<br/>mflag = true"]
  BR6 -- No --> BR6b["mflag = false"]
  BR6a --> BR7
  BR6b --> BR7["fs = f(s); d=c; c=b; fc=fb"]
  BR7 --> BR8{"fa*fs < 0?"}
  BR8 -- Yes --> BR8a["b = s; fb = fs"]
  BR8 -- No --> BR8b["a = s; fa = fs"]
  BR8a --> BR9
  BR8b --> BR9{"abs(fa) < abs(fb)?"}
  BR9 -- Yes --> BR9a["swap(a,b), swap(fa,fb)"]
  BR9 -- No --> BR10
  BR9a --> BR10{"abs(b-a) < tol<br/>or fb == 0?"}
  BR10 -- Yes --> BROK["return b"]
  BR10 -- No --> BR11["iter++"]
  BR11 --> BR12{"iter < 100?"}
  BR12 -- Yes --> BR5
  BR12 -- No --> BROK2["return b (best estimate)"]
end

subgraph HL["heatLoad.js — calcHeatLoads(geom, temps, electrical,<br/>PIPEPITCH, backCondenserEfficiency, fanInputPower_W,<br/>freezerPosition, backCondenser)"]
  HL0["Compute K_side, K_back (pitch correction)<br/>T_compZone, TRise_side/back, T_wallSide/back<br/>flags: isTopFreezer, isBackCondenserAbsent,<br/>hasFreezer=Hf>0, hasFresh=Hr>0"] --> HL1{"hasFreezer?"}

  HL1 -- Yes --> HL2["Compute AFtop, AFdoor, AFpackin,<br/>AFleft1/2, AFright1/2<br/>(split formula differs: top-freezer<br/>vs bottom-freezer w/ compressor step)"]
  HL2 --> HL3{"isTopFreezer?"}
  HL3 -- Yes --> HL3a["QF += kExterior(tFtop)*AFtop*(T0-TF)"]
  HL3 -- No --> HL3b["QF += kInterior(tFtop)*AFtop*(TR-TF)"]
  HL3a --> HL4
  HL3b --> HL4["QF += sides conduction:<br/>kExterior(left/right,TF,wallSide)*area1<br/>+ kExterior(left/right,T2,wallSide)*area2"]
  HL4 --> HL5{"hasFresh?"}
  HL5 -- No --> HL6a["QF += stepped-floor 3-zone exterior<br/>conduction (AFb1,AFb2 vs T_compZone;<br/>AFb3 vs T0)"]
  HL5 -- Yes --> HL6{"isTopFreezer?"}
  HL6 -- Yes --> HL6b["QF += kInterior(tFbottom)*AFbottom*(TR-TF)<br/>(single interior partition)"]
  HL6 -- No --> HL6c["QF += stepped-floor 3-zone exterior<br/>conduction (bottom-freezer case)"]
  HL6a --> HL7
  HL6b --> HL7
  HL6c --> HL7["QF += door+packing leak<br/>QF += DP partition losses<br/>(Qdpfr-style + Qdpf-style terms)"]
  HL7 --> HL8
  HL1 -- No --> HL8{"hasFresh?"}

  HL8 -- Yes --> HL9["Compute ARdoor, ARpackin,<br/>ARtop/left/back<br/>(formula differs by isTopFreezer)"]
  HL9 --> HL10{"isTopFreezer?"}
  HL10 -- Yes --> HL10a["QR += kInterior(tRtop)*ARtop*(TF-TR)"]
  HL10 -- No --> HL10b["QR += kExterior(tRtop)*ARtop*(T0-TR)"]
  HL10a --> HL11
  HL10b --> HL11["QR += sides conduction<br/>kExterior(left/right,TR,wallSide)*ARleft"]
  HL11 --> HL12{"isBackCondenserAbsent?"}
  HL12 -- Yes --> HL12a["QR += kExterior(tRback)*ARback*(T0-TR)"]
  HL12 -- No --> HL12b["QR += kExterior(tRback)*ARback*(wallBack-TR)"]
  HL12a --> HL13
  HL12b --> HL13{"!hasFreezer OR<br/>isTopFreezer?"}
  HL13 -- Yes --> HL13a["QR += stepped-floor 3-zone exterior<br/>conduction (ARb1,ARb2 vs T_compZone;<br/>ARb3 vs T0)"]
  HL13 -- No --> HL13b["QR += kInterior(tRfloor)*ARbottom*(TF-TR)<br/>(interior — bottom-freezer, fresh on top)"]
  HL13a --> HL14
  HL13b --> HL14["QR += door+packing<br/>QR += DP condenser term"]
  HL14 --> HL15
  HL8 -- No --> HL15["Evaporator & parasitic block<br/>(always executes)"]

  HL15 --> HL16["Select H_evap, wall thicknesses:<br/>hasFreezer? use freezer dims : use fresh dims<br/>tBottom_evap chosen via freezerPosition/hasFreezer"]
  HL16 --> HL17{"isTopFreezer<br/>or !hasFreezer?"}
  HL17 -- Yes --> HL17a["A_evaBack = (W-sides)*(H_evap-top/bottom)<br/>(simple rectangle)"]
  HL17 -- No --> HL17b["A_evaBack = (W-sides)*(H_evap-Hb-top/bottom)<br/>(subtract compressor step height)"]
  HL17a --> HL18
  HL17b --> HL18{"A_evaBack > 0?"}
  HL18 -- Yes --> HL19{"isBackCondenserAbsent?"}
  HL19 -- Yes --> HL19a["QEV_cond = kExterior(tEvaBack,T2,T0)*A_evaBack*(T0-T2)"]
  HL19 -- No --> HL19b["QEV_cond = kExterior(tEvaBack,T2,wallBack)*A_evaBack*(wallBack-T2)"]
  HL18 -- No --> HL20["QEV_cond = 0"]
  HL19a --> HL21
  HL19b --> HL21
  HL20 --> HL21["fanLoad = fanInputPower_W * PR<br/>defrostEventsPerDay = 24/(timerPeriod_h/PR)<br/>defrostLoad = defrostHeater*(defOnMin/60)*(events/24)"]
  HL21 --> HLOK["return {QF, QR,<br/>QEV: QEV_cond+fanLoad+defrostLoad,<br/>fanLoad, defrostLoad,<br/>totalLoad: QF+QR+QEV_cond+fanLoad+defrostLoad}"]
end

subgraph COND["condenser.js — calcQCout(geom, TC, T0, TF, TR, PR,<br/>PIPEPITCH, freezerPosition, backCondenserEfficiency)"]
  COND0["sideArea = f(H,D,Hb,Db1,Db2)<br/>backArea = backAreaRaw * backCondenserEfficiency<br/>K_side, K_back = quadratic pitch correction"] --> COND1["Qdpfr = partition DP formula<br/>(0.1984*(TC-T0) + 0.1219*(TC-TF))*PR*(W-tFsides)"]
  COND1 --> COND2{"freezerPosition<br/>== 'top'?"}
  COND2 -- Yes --> COND2a["Qdpf uses (Hf*2+W)<br/>Qdpr uses (Hr*2)"]
  COND2 -- No --> COND2b["Qdpf uses (Hf*2)<br/>Qdpr uses (Hr*2+W)"]
  COND2a --> COND3
  COND2b --> COND3["Qdp = Qdpfr + Qdpf + Qdpr<br/>Qside = K_side*sideArea*(TC-T0)*1.16279<br/>Qback = K_back*backArea*(TC-T0)*1.16279"]
  COND3 --> CONDOK["return {Qdpfr,Qdpf,Qdpr,Qdp,Qside,Qback,<br/>QCout: Qdp+Qside+Qback}"]
end

subgraph CMP["CompressorPerformance.js — RUNTIME evaluation<br/>(evaluateCompressorSafely)"]
  CMP0{"compParams.compressorModel<br/>is an object?"}

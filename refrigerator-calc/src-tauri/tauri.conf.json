{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "refrigerator-calc",
  "version": "0.1.0",
  "identifier": "com.ahmed.refrigerator-calc",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
  "windows": [
    {
      "title": "Refrigerator Net Storage Volume Calculator",
      "width": 1200,
      "height": 900,
      "resizable": true,
      "fullscreen": false
    }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
